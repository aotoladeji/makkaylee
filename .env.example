# Used only by the local development build. Production uses same-origin /api.
REACT_APP_API_URL=http://localhost:5000/api

GENERATE_SOURCEMAP=false

# Cloudinary Configuration (Required for file uploads)
# Get these values from your Cloudinary account at https://cloudinary.com
# 1. Sign up at https://cloudinary.com
# 2. Go to Dashboard and copy your Cloud Name
# 3. Create an upload preset in Settings > Upload > Upload presets (unsigned)
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
REACT_APP_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here
