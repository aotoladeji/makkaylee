{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/database/makkaylee.sqlite"
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
